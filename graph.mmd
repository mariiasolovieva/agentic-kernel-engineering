average_kernel -.->|instance_of| PoolingMethod

%% Feature vectors
pooled_SOAP_vector["pooled_SOAP_vector"]
pooled_SOAP_vector -.->|instance_of| FeatureVector

%% MLIPs
MACE_MP_0["MACE_MP_0"]
GAP["GAP"]
