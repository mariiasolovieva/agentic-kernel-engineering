flowchart TB

%% ==================== DOMAIN: MATERIALS & STRUCTURE ====================
subgraph MAT["Materials & Structure"]
    Material["Material"]
    Structure["Structure"]
    IntercalationSite["IntercalationSite"]
    Material -->|hasStructure| Structure
    Structure -->|hasSite| IntercalationSite
end

%% ==================== DOMAIN: DESCRIPTORS & FEATURES ====================
subgraph DESC["Descriptors & Features"]
    Descriptor["Descriptor"]
    PoolingMethod["PoolingMethod"]
    FeatureVector["FeatureVector"]
    Structure -.->|describedBy| Descriptor
    Descriptor -->|pooledBy| PoolingMethod
    PoolingMethod -->|produces| FeatureVector
end

%% ==================== DOMAIN: MODELS & OPTIMIZATION ====================
subgraph OPT["Models & Optimization"]
    MLIP["MLIP"]
    SurrogateModel["SurrogateModel"]
    Kernel["Kernel"]
    AcquisitionFunction["AcquisitionFunction"]
    GlobalOptimizer["GlobalOptimizer"]
    ObjectiveFunction["ObjectiveFunction"]
    Structure -.->|evaluatedBy| MLIP
    SurrogateModel -->|approximates| ObjectiveFunction
    SurrogateModel -->|usesKernel| Kernel
    GlobalOptimizer -->|usesSurrogate| SurrogateModel
    GlobalOptimizer -->|usesAcquisition| AcquisitionFunction
    GlobalOptimizer -->|optimizes| ObjectiveFunction
end

%% ==================== DOMAIN: EXPERIMENTS & RESULTS ====================
subgraph EXP["Experiments & Results"]
    Experiment["Experiment"]
    Result["Result"]
    Experiment -->|producesResult| Result
end

%% ==================== INSTANCES (leaf nodes) ====================
%% Materials
graphite["graphite"]
silicon["silicon"]
graphite -.->|instance_of| Material
silicon -.->|instance_of| Material

%% Structures
graphite_Li_config["graphite_Li_config"]
graphite_Li_config -.->|instance_of| Structure

%% Intercalation sites
intercalation_site["intercalation_site"]
intercalation_site -.->|instance_of| IntercalationSite

%% Descriptors
SOAP["SOAP"]
ACSF["ACSF"]
CoulombMatrix["CoulombMatrix"]
SOAP -.->|instance_of| Descriptor
ACSF -.->|instance_of| Descriptor
CoulombMatrix -.->|instance_of| Descriptor

%% Pooling methods
statistical_pooling["statistical_pooling"]
average_kernel["average_kernel"]
